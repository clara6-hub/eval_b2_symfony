{% extends 'base.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_home') }}">
        ← Retour aux événements
    </a>

    <article class="cat-{{ event.category }}">
        <header class="detail-hero"
            style="background-image: url('{{ event.image ? asset('uploads/events/' ~ event.image) : asset('images/concert.jpg') }}')">

            <div class="detail-hero-content">
                <span class="badge">
                    {{ event.category|capitalize }}
                </span>

                <h1>{{ event.title }}</h1>
                <p>{{ event.date|date('d/m/Y · H\\hi') }}</p>
            </div>
        </header>

        <div class="detail-grid">
            <section class="card">
                <h2>Informations</h2>
                <p>{{ event.informations|nl2br }}</p>

                <h2>Participants inscrits</h2>

                {% if event.participants is empty %}
                    <p class="muted">Aucun participant pour le moment.</p>
                {% else %}
                    <ul>
                        {% for participant in event.participants %}
                            <li>{{ participant.email }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            <aside class="card booking">
                <p class="places">
                    <strong>{{ event.numberOfPlaces }}</strong>
                    places restantes
                </p>

                {% if app.user and app.user in event.participants %}
                    <p class="muted">
                        Vous êtes inscrit à cet événement.
                    </p>

                    <form method="post"
                          action="{{ path('app_event_unregister', {id: event.id}) }}">

                        <input type="hidden"
                               name="_token"
                               value="{{ csrf_token('unregister' ~ event.id) }}">

                        <button type="submit"
                                class="btn btn-secondary btn-block">
                            Se désinscrire
                        </button>
                    </form>

                {% elseif event.numberOfPlaces <= 0 %}
                    <p class="places">
                        <span class="badge badge-full">Complet</span>
                    </p>

                    <button class="btn btn-block" disabled>
                        Complet
                    </button>

                {% elseif not event.isValidated %}
                    <p class="muted">
                        Cet événement est en attente de validation.
                    </p>

                {% elseif not app.user %}
                    <a class="btn btn-block" href="{{ path('app_login') }}">
                        Connectez-vous pour vous inscrire
                    </a>

                {% else %}
                    <form method="post"
                          action="{{ path('app_event_register', {id: event.id}) }}">

                        <input type="hidden"
                               name="_token"
                               value="{{ csrf_token('register' ~ event.id) }}">

                        <button type="submit" class="btn btn-block">
                            S'inscrire
                        </button>
                    </form>
                {% endif %}
            </aside>
        </div>
    </article>
{% endblock %}
